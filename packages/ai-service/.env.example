# 智谱 GLM（从 https://open.bigmodel.cn/ 获取）
GLM_API_KEY=

# Google Gemini（从 https://aistudio.google.com/ 获取）
GEMINI_API_KEY=

# 硅基流动 SiliconFlow（从 https://cloud.siliconflow.cn/ 获取）
# 用于：翻译（腾讯混元 MT）与 对话总结（通义千问）
SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# HUNYUAN_TRANSLATE_MODEL=tencent/Hunyuan-MT-7B
# QWEN_SUMMARY_MODEL=Qwen/Qwen3-8B

# 可选：模型与调用参数配置（仅可调用以下白名单模型，默认选最新）
# GLM_TEXT_MODEL=glm-4.7-flash
# GLM_TEXT_FALLBACK_MODEL=glm-4-flash-250414
# GLM_VISION_MODEL=glm-4.6v-flash
# GLM_VISION_THINK_MODEL=glm-4.1v-thinking-flash
# GLM_VISION_FALLBACK_MODEL=glm-4v-flash
# GLM_IMAGE_MODEL=cogview-3-flash
# GLM_IMAGE_SIZE=1024x1024
# GEMINI_MODEL=gemini-3.7-flash
# 可用模型：gemini-3.7-flash / gemini-3.6-flash / gemini-3.5-flash / gemini-3.5-flash-lite /
#           gemini-3.1-flash-lite / gemini-3-flash-preview /
#           gemini-2.5-pro / gemini-2.5-flash
# 开关：需要能访问 Google 时才设为 true（默认 false，避免超时等待）
# GEMINI_ENABLED=true
# REQUEST_TIMEOUT=120

# 知识库 / RAG（以下均有默认值，通常无需修改）
# KNOWLEDGE_BASE_DIR=/data/knowledge
# SQLITE_DB_PATH=/data/memory.db
# CHROMA_PERSIST_DIR=/data/chroma
# CHROMA_COLLECTION_NAME=knowledge
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.35                      # 检索最低相似度阈值（0.0~1.0），低于此分数视为无关并过滤

# Context Engine（上下文管理，均有默认值，通常无需修改）
# AI_SYSTEM_PROMPT=                      # 可选：基础系统提示（默认空 = 不注入）
# CONTEXT_DEFAULT_WINDOW=128000          # 未知模型的默认上下文窗口（token）
# CONTEXT_SAFETY_MARGIN=2048             # 预算安全余量（抵消 token 估算误差）
# CONTEXT_MAX_TOKENS=0                   # 输入预算硬上限（0 = 按模型窗口自动）
# CONTEXT_OUTPUT_RESERVE_TOKENS=0        # 预留输出 token（0 = 按模型最大输出自动）
# CONTEXT_MAX_HISTORY_ROUNDS=15          # 短期上下文：最近 N 轮
# CONTEXT_ROLLING_COMPRESS_ROUNDS=10     # 超窗时一次压缩进滚动摘要的轮数
# CONTEXT_SUMMARY_TRIGGER_TOKENS=24000   # 历史 token 超过该值触发异步滚动摘要
# MODEL_CONTEXT_WINDOW_OVERRIDES={"glm-4.7-flash": 200000}   # 模型窗口覆盖（JSON）
# CONTEXT_AUTO_MEMORY=true               # 后端按消息自动判断是否携带长期记忆
# CONTEXT_AUTO_RAG=true                  # 后端按消息自动判断是否检索知识库
# GEMINI_MAX_OUTPUT_TOKENS=65536         # Gemini 预留输出上限
