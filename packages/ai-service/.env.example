# 智谱 GLM（从 https://open.bigmodel.cn/ 获取）
GLM_API_KEY=

# Google Gemini（从 https://aistudio.google.com/ 获取）
GEMINI_API_KEY=

# 可选：模型与调用参数配置
# GLM_MODEL=glm-4.7-flash
# GEMINI_MODEL=gemini-flash-latest
# 开关：需要能访问 Google 时才设为 true（默认 false，避免超时等待）
# GEMINI_ENABLED=true
# REQUEST_TIMEOUT=120

# 知识库 / RAG（以下均有默认值，通常无需修改）
# KNOWLEDGE_BASE_DIR=/data/knowledge
# SQLITE_DB_PATH=/data/memory.db
# CHROMA_PERSIST_DIR=/data/chroma
# CHROMA_COLLECTION_NAME=knowledge
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=3
