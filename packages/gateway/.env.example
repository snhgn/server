# ============ API Gateway 配置 ============
# 复制本文件为 .env 并填写真实值

# ---- 认证 ----
# 管理员密码的 bcrypt 哈希
# 生成方式: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# 注意: docker-compose 中 bcrypt 哈希的 $ 必须转义为 $$（变量替换规则）
ADMIN_PASSWORD_HASH=

# JWT 签名密钥（64 位 hex）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ---- 用户数据库 ----
# SQLite 路径（容器内）
SQLITE_DB_PATH=/data/gateway.db

# ---- 内部服务地址（容器名:端口）----
AI_SERVICE_URL=http://ai-service:8000
SCHEDULER_SERVICE_URL=http://scheduler:8002

# ---- 通用 ----
# 请求超时（秒）—— 需大于 AI 模型最长响应时间
REQUEST_TIMEOUT=130
