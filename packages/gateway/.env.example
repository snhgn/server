# ============ API Gateway 配置 ============
# 复制本文件为 .env 并填写真实值

# ---- 认证 ----
# 管理员密码的 bcrypt 哈希
# 生成方式: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# 注意: docker-compose 中 bcrypt 哈希的 $ 必须转义为 $$（变量替换规则）
ADMIN_PASSWORD_HASH=

# JWT 签名密钥（64 位 hex）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ---- 用户数据库 ----
# SQLite 路径（容器内）
SQLITE_DB_PATH=/data/gateway.db

# ---- 内部服务地址（容器名:端口）----
AI_SERVICE_URL=http://ai-service:8000
SCHEDULER_SERVICE_URL=http://scheduler:8002

# ---- Schedule 课表模块（以下有默认值，可留空）----
# 课表缓存有效期（小时），缓存期内不重复访问教务系统
# SCHEDULE_CACHE_TTL_HOURS=6
# 同一用户两次爬取的最小间隔（秒）
# SCHEDULE_COOLDOWN_SECONDS=30
# 单次爬取总超时（秒）
# SCHEDULE_CRAWL_TIMEOUT=75
# 验证码识别最大重试次数
# SCHEDULE_CAPTCHA_MAX_RETRY=5

# ---- 通用 ----
# 请求超时（秒）—— 需大于 AI 模型最长响应时间
REQUEST_TIMEOUT=130
