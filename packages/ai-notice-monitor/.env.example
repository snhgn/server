# ============ 复制本文件为 .env 并填写真实值 ============

# ---- 网页抓取 ----
NOTICE_BASE_URL=https://cos.bjfu.edu.cn/tzgg/index.html
SCRAPER_MAX_PAGES=2
SCRAPER_TIMEOUT=15
SCRAPER_RETRIES=3

# ---- 数据库 ----
# 默认放在项目目录下，可改为绝对路径
DB_PATH=notices.db

# ---- AI 摘要（默认本地 Ollama）----
# provider: ollama / deepseek / openai
AI_PROVIDER=ollama
AI_MODEL=qwen3-4b-8k:latest
# ollama 本地: http://localhost:11434/v1
# deepseek:  https://api.deepseek.com/v1  （key 填 deepseek 的）
# openai:    https://api.openai.com/v1    （key 填 openai 的）
AI_API_BASE=http://localhost:11434/v1
AI_API_KEY=ollama
AI_TIMEOUT=60
AI_MAX_CONTENT_CHARS=3000

# ---- 邮件（QQ / 163 通用）----
# QQ:   smtp.qq.com / 465
# 163:  smtp.163.com / 465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 发件邮箱
SMTP_SENDER=your_email@qq.com
# 授权码（QQ/163 在设置里开启 SMTP 获取，不是登录密码）
SMTP_AUTH_CODE=your_auth_code
# 收件邮箱（可以是自己）
SMTP_RECEIVER=your_email@qq.com

# ---- 运行行为 ----
# 首次运行是否发送所有历史通知。false = 历史只入库不发送，只发新通知
FIRST_RUN_SEND_ALL=false
