# ============ Scheduler 服务配置 ============
# 复制本文件为 .env 并填写真实值

# SQLite 持久化路径（容器内）
SQLITE_DB_PATH=/data/sqlite/scheduler.db

# 时区（cron 表达式按此时区执行）
TIMEZONE=Asia/Shanghai

# 任务执行超时（秒）
JOB_TIMEOUT=300

# 历史记录保留条数（超出自动清理最旧记录）
HISTORY_LIMIT=100

# ---- Scripts 自动化模块（以下有默认值，可留空）----
# SCRIPTS_DB_PATH=/data/sqlite/scripts.db
# SCRIPTS_LOG_DIR=/app/logs/scripts
# SCRIPT_TIMEOUT=1800
# AI_SERVICE_URL=http://ai-service:8000
